{
	"folders": [
		{
			"path": ".",
			"name": "LOGIK-PROJEKT-BJOIN-STUDIO"
		}
	],
	"settings": {
		// Python settings
		"python.defaultInterpreterPath": "/usr/bin/python3",
		"python.linting.enabled": true,
		"python.linting.pylintEnabled": false,
		"python.linting.flake8Enabled": true,
		"python.formatting.provider": "black",

		// Editor settings
		"editor.formatOnSave": false,
		"editor.rulers": [88, 120],
		"editor.tabSize": 4,
		"editor.insertSpaces": true,

		// Files
		"files.exclude": {
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/.DS_Store": true
		},
		"files.watcherExclude": {
			"**/__pycache__/**": true
		},

		// Git
		"git.ignoreLimitWarning": true,

		// Workspace specific - Blue theme for LOGIK
		"workbench.colorCustomizations": {
			"activityBar.background": "#1a2a3a",
			"titleBar.activeBackground": "#1a2a3a",
			"titleBar.activeForeground": "#a0d0ff"
		}
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.vscode-pylance",
			"continue.continue",
			"eamodio.gitlens",
			"github.copilot"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python: Current File",
				"type": "python",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal"
			}
		]
	}
}
