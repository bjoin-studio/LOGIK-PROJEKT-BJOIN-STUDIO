# =============================================================================
# BJOIN-STUDIO Custom OCIO Config
# Based on ACES 1.3 workflow with ACES 1.0 SDR output
# =============================================================================
#
# Workflow: Camera → ACEScg (working) → ACEScct (grading) → ACES 1.0 SDR Rec.709
#
# This config uses Flame's native CTF transforms for compatibility.
# 
# Compatible with:
# - Autodesk Flame 2026
# - Foundry Nuke 16
# - DaVinci Resolve
#
# Created: 2025-01-11
# Author: BJoin Studio
# =============================================================================

ocio_profile_version: 2.1

environment:
  {}

# Reference Flame's CTF files
search_path:
  - /opt/Autodesk/colour_mgmt/configs/legacy_configs/syncolor_aces1.1_config/syncolor_ctfs

strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

name: BJoin Studio ACES 1.3
description: |
  BJoin Studio Custom OCIO Config
  
  Working Space: ACEScg
  Grading Space: ACEScct
  Output: ACES 1.0 SDR Video (Rec.709)
  
  Camera Support:
  - RED (REDLog3G10 / REDWideGamutRGB)
  - ARRI (LogC3 EI800 / ALEXA Wide Gamut)
  - ARRI (LogC4 / ALEXA Wide Gamut 4)
  - Sony (S-Log3 / S-Gamut3, S-Gamut3.Cine)
  - Blackmagic (Film / Wide Gamut)
  - Canon (C-Log3 / Cinema Gamut)
  
  Version: 1.0.0

# =============================================================================
# ROLES
# =============================================================================
roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_picking: sRGB
  color_timing: ACEScct
  compositing_log: ACEScct
  data: Raw
  default: ACEScg
  matte_paint: ACEScct
  rendering: ACEScg
  scene_linear: ACEScg
  texture_paint: sRGB

# =============================================================================
# FILE RULES
# =============================================================================
file_rules:
  - !<Rule> {name: EXR, colorspace: ACEScg, pattern: "*", extension: "exr"}
  - !<Rule> {name: DPX, colorspace: ACEScg, pattern: "*", extension: "dpx"}
  - !<Rule> {name: R3D, colorspace: "RED Log3G10 REDWideGamutRGB", pattern: "*.R3D", extension: "r3d"}
  - !<Rule> {name: MXF-ARRI, colorspace: "ARRI LogC3 EI800", pattern: "*arri*", extension: "mxf"}
  - !<Rule> {name: MXF-Sony, colorspace: "Sony S-Log3 S-Gamut3", pattern: "*sony*", extension: "mxf"}
  - !<Rule> {name: Default, colorspace: ACEScg}

# =============================================================================
# DISPLAYS & VIEWS
# =============================================================================
displays:
  sRGB:
    - !<View> {name: ACES 1.0 SDR, view_transform: ACES 1.0 SDR Video, display_colorspace: sRGB Display}
    - !<View> {name: Raw, colorspace: Raw}
  
  Rec.709:
    - !<View> {name: ACES 1.0 SDR, view_transform: ACES 1.0 SDR Video, display_colorspace: Rec.709 Display}
    - !<View> {name: Raw, colorspace: Raw}

active_displays: [sRGB, Rec.709]
active_views: [ACES 1.0 SDR, Raw]
default_view_transform: ACES 1.0 SDR Video

# =============================================================================
# VIEW TRANSFORMS
# =============================================================================
view_transforms:
  - !<ViewTransform>
    name: ACES 1.0 SDR Video
    description: |
      ACES 1.0 Output Transform for SDR video (Rec.709)
      The classic ACES look.
    from_scene_reference: !<FileTransform> {src: RRT+ODT/ACES_to_HD-video_1.0.ctf}

# =============================================================================
# DISPLAY COLORSPACES
# =============================================================================
display_colorspaces:
  - !<ColorSpace>
    name: sRGB Display
    family: Display
    encoding: sdr-video
    isdata: false
    from_display_reference: !<FileTransform> {src: gamma/apply_sRGB_encoding.ctf}
  
  - !<ColorSpace>
    name: Rec.709 Display
    family: Display
    encoding: sdr-video
    isdata: false
    from_display_reference: !<FileTransform> {src: gamma/apply_2.40_gamma.ctf}

# =============================================================================
# COLORSPACES
# =============================================================================
colorspaces:

  # ---------------------------------------------------------------------------
  # ACES Core
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: ACES2065-1
    family: ACES
    encoding: scene-linear
    description: |
      ACES 2065-1 (AP0 primaries, linear)
      The ACES interchange colorspace
    isdata: false
    allocation: lg2
    allocationvars: [-8, 5, 0.00390625]
  
  - !<ColorSpace>
    name: ACEScg
    family: ACES
    encoding: scene-linear
    description: |
      ACEScg (AP1 primaries, linear)
      YOUR WORKING COLORSPACE
    isdata: false
    allocation: lg2
    allocationvars: [-8, 5, 0.00390625]
    to_scene_reference: !<FileTransform> {src: primaries/ACEScg_to_ACES.ctf}
  
  - !<ColorSpace>
    name: ACEScct
    family: ACES
    encoding: log
    description: |
      ACEScct (AP1 primaries, log encoding)
      YOUR GRADING COLORSPACE
    isdata: false
    allocation: uniform
    allocationvars: [-0.249136, 1.468]
    to_scene_reference: !<FileTransform> {src: interchange/ACESproxy/ACEScct_to_ACES2065-1.ctf}

  - !<ColorSpace>
    name: ACEScc
    family: ACES
    encoding: log
    description: ACEScc (AP1 primaries, pure log)
    isdata: false
    allocation: uniform
    allocationvars: [-0.3584, 1.468]
    to_scene_reference: !<FileTransform> {src: interchange/ACESproxy/ACEScc_to_ACES2065-1.ctf}

  # ---------------------------------------------------------------------------
  # RED Camera
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: RED Log3G10 REDWideGamutRGB
    family: Input/RED
    encoding: log
    description: |
      RED Log3G10 / REDWideGamutRGB
      For R3D footage
    isdata: false
    allocation: uniform
    allocationvars: [-0.2, 1.6]
    to_scene_reference: !<FileTransform> {src: camera/Red/Log3G10-REDWideGamutRGB_to_ACES.ctf}

  # ---------------------------------------------------------------------------
  # ARRI Camera
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: ARRI LogC3 EI800
    family: Input/ARRI
    encoding: log
    description: |
      ARRI LogC3 (EI800) / ALEXA Wide Gamut
      For ARRI ALEXA footage
    isdata: false
    allocation: uniform
    allocationvars: [-0.1, 1.5]
    to_scene_reference: !<FileTransform> {src: camera/Arri/Alexa-v3-LogC-EI800_to_ACES.ctf}
  
  - !<ColorSpace>
    name: ARRI LogC4
    family: Input/ARRI
    encoding: log
    description: |
      ARRI LogC4 / ALEXA Wide Gamut 4
      For ARRI ALEXA 35 footage
    isdata: false
    allocation: uniform
    allocationvars: [-0.3, 1.6]
    to_scene_reference: !<FileTransform> {src: camera/Arri/LogC4-AWG4_to_ACES.ctf}

  # ---------------------------------------------------------------------------
  # Sony Camera
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: Sony S-Log3 S-Gamut3
    family: Input/Sony
    encoding: log
    description: |
      Sony S-Log3 / S-Gamut3
      For Sony Venice, FX6, FX9, etc.
    isdata: false
    allocation: uniform
    allocationvars: [-0.1, 1.5]
    to_scene_reference: !<FileTransform> {src: camera/Sony/SLog3-SGamut3_to_ACES.ctf}
  
  - !<ColorSpace>
    name: Sony S-Log3 S-Gamut3.Cine
    family: Input/Sony
    encoding: log
    description: Sony S-Log3 / S-Gamut3.Cine
    isdata: false
    allocation: uniform
    allocationvars: [-0.1, 1.5]
    to_scene_reference: !<FileTransform> {src: camera/Sony/SLog3-SGamut3.Cine_no-cam-black_to_ACES.ctf}

  # ---------------------------------------------------------------------------
  # Blackmagic Camera
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: Blackmagic Film WideGamut
    family: Input/Blackmagic
    encoding: log
    description: |
      Blackmagic Film / Wide Gamut
      For BMPCC 6K, URSA, etc.
    isdata: false
    allocation: uniform
    allocationvars: [-0.1, 1.5]
    to_scene_reference: !<FileTransform> {src: camera/BlackmagicDesign/BMDFilm-BMDWideGamut_to_ACES.ctf}

  - !<ColorSpace>
    name: DaVinci Intermediate WideGamut
    family: Input/Blackmagic
    encoding: log
    description: |
      DaVinci Intermediate / DaVinci Wide Gamut
      For Resolve timeline workflow
    isdata: false
    allocation: uniform
    allocationvars: [-0.1, 1.5]
    to_scene_reference: !<FileTransform> {src: camera/BlackmagicDesign/DaVinciIntermediate-DaVinciWideGamut_to_ACES.ctf}

  # ---------------------------------------------------------------------------
  # Canon Camera
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: Canon Log3 CinemaGamut D55
    family: Input/Canon
    encoding: log
    description: |
      Canon Log3 / Cinema Gamut (D55 illuminant)
      For Canon C300 Mark III, C500 Mark II, R5C, etc.
    isdata: false
    allocation: uniform
    allocationvars: [-0.1, 1.5]
    to_scene_reference: !<FileTransform> {src: camera/Canon/CanonLog3-CinemaGamut-D55_to_ACES.ctf}

  # ---------------------------------------------------------------------------
  # Output Colorspaces
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: Rec.709
    family: Output
    encoding: sdr-video
    description: |
      Rec.709 / BT.1886 (2.4 gamma)
      Primary output for TV delivery
    isdata: false
    from_scene_reference: !<FileTransform> {src: RRT+ODT/ACES_to_HD-video_1.0.ctf}
  
  - !<ColorSpace>
    name: sRGB
    family: Output
    encoding: sdr-video
    description: sRGB for web delivery
    isdata: false
    from_scene_reference: !<FileTransform> {src: RRT+ODT/ACES_to_sRGB_1.0.ctf}

  # ---------------------------------------------------------------------------
  # Utility
  # ---------------------------------------------------------------------------
  - !<ColorSpace>
    name: Raw
    family: Utility
    encoding: data
    description: Data (no color transform)
    isdata: true
  
  - !<ColorSpace>
    name: CIE-XYZ-D65
    family: Utility
    encoding: scene-linear
    description: CIE XYZ with D65 white point
    isdata: false
    to_scene_reference: !<FileTransform> {src: primaries/CIE-XYZ_to_ACES.ctf}

  - !<ColorSpace>
    name: Linear sRGB
    family: Utility
    encoding: scene-linear
    description: Linear Rec.709/sRGB for interchange
    isdata: false
    to_scene_reference: !<FileTransform> {src: primaries/LinearRec709-sRGB_to_ACES.ctf}
